  "bugs": {
    "url": "https://github.com/luislima9970/automata-builder/issues"
  },
  "homepage": "https://github.com/luislima9970/automata-builder#readme",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^1.6.0"
  }
}
